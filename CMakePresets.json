{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio)",
      "description": "Target Windows x64 with Visual Studio generator",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release (x64)",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Debug (x64)",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    }
  ]
}
